% cvstyle.sty — shared layout for the CV and the publication list
% Options:  [rightdates]  dates flush right on the entry line (default)
%           [leftdates]   dates in a fixed left column ("classic academic")
\ProvidesPackage{cvstyle}

\newif\ifleftdates \leftdatesfalse
\DeclareOption{leftdates}{\leftdatestrue}
\DeclareOption{rightdates}{\leftdatesfalse}
\ProcessOptions\relax

\usepackage[T1]{fontenc}
\usepackage[utf8]{inputenc}
\usepackage{charter}
\usepackage[a4paper,margin=0.75in,top=0.65in,bottom=0.75in]{geometry}
\usepackage{microtype}
\usepackage{enumitem}
\usepackage{titlesec}
\usepackage{tabularx}
\usepackage{array}
\usepackage{xcolor}
\usepackage{fancyhdr}
\usepackage[hidelinks]{hyperref}

\definecolor{softgray}{gray}{0.40}
\definecolor{linkblue}{RGB}{30,70,140}
\hypersetup{colorlinks=true, urlcolor=linkblue, linkcolor=black}

\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0pt}
\fancyfoot[L]{\small\color{softgray}Joon-Hyuk Ko --- Curriculum Vitae}
\fancyfoot[R]{\small\color{softgray}\thepage}

\setlength{\parindent}{0pt}
\setlength{\parskip}{0pt}

% Width of the left date column in the leftdates layout
\newlength{\datecol}
\setlength{\datecol}{1.05in}

% ---------- Headings ----------
% Name (used in the CV and publication list headers)
\newcommand{\cvname}[1]{{\LARGE\scshape #1}}
% Section headings: small caps, no rule.  Spacing = {left}{before}{after}
\titleformat{\section}{\large\scshape}{}{0pt}{}
\titlespacing*{\section}{0pt}{1.4em}{0.6em}
% Subsection headings (e.g. "Preprints", "Invited talks"): italic
\titleformat{\subsection}{\normalsize\itshape}{}{0pt}{}
\titlespacing*{\subsection}{0pt}{0.8em}{0.35em}

% ---------- Entries:  \entry{title}{date}{details} ----------
\ifleftdates
  \newcommand{\entry}[3]{%
    \par\noindent
    {\color{softgray}\parbox[t]{\datecol}{\raggedright\strut#2}}%
    \parbox[t]{\dimexpr\linewidth-\datecol\relax}{\strut\textbf{#1}\ifx\relax#3\relax\else\\#3\fi}%
    \par\vspace{0.45em}}
\else
  \newcommand{\entry}[3]{%
    \par\noindent
    \begin{tabularx}{\linewidth}{@{}X@{\hspace{1em}}r@{}}
      \textbf{#1} & #2 \\
    \end{tabularx}\par
    \ifx\relax#3\relax\else{#3}\par\fi
    \vspace{0.45em}}
\fi

% Bullet notes under an entry (indented to the text column in leftdates)
\newlist{notes}{itemize}{1}
\ifleftdates
  \setlist[notes]{label=\textbullet, leftmargin=\dimexpr\datecol+1.1em\relax, itemsep=0.15em, topsep=-0.2em, parsep=0pt, after=\vspace{0.55em}}
\else
  \setlist[notes]{label=\textbullet, leftmargin=1.2em, itemsep=0.15em, topsep=0.1em, parsep=0pt, after=\vspace{0.55em}}
\fi

% Plain bullet list for research interests
\newlist{interests}{itemize}{1}
\setlist[interests]{label=\textbullet, leftmargin=1.2em, itemsep=0.25em, topsep=0.35em, parsep=0pt}

% ---------- Publications: numbered; title / authors / venue on separate lines ----------
\newlist{pubs}{enumerate}{1}
\setlist[pubs]{label=[\arabic*], leftmargin=2.4em, labelsep=0.6em, itemsep=0.45em, topsep=0.3em, parsep=0pt, resume}
% \pub{title}{authors}{venue}
\newcommand{\pub}[3]{\item{\interlinepenalty=10000 #1\\ #2\\ {\color{softgray}#3}\par}}

% ---------- Talks ----------
% \talk{title}{venue}{date}
\ifleftdates
  % classic layout: date in the left column, like every other dated entry
  \newlist{talks}{itemize}{1}
  \setlist[talks]{label={}, leftmargin=0pt, itemsep=0.45em, topsep=0.3em, parsep=0pt}
  \newcommand{\talk}[3]{\item{\color{softgray}\parbox[t]{\datecol}{\strut#3}}\parbox[t]{\dimexpr\linewidth-\datecol\relax}{\strut#1\\\textit{#2}}}
\else
  % numbered; date flush right on the title line
  \newlist{talks}{enumerate}{1}
  \setlist[talks]{label=\arabic*., leftmargin=2.0em, labelsep=0.6em, itemsep=0.35em, topsep=0.3em, parsep=0pt}
  \newcommand{\talk}[3]{\item\begin{minipage}[t]{\linewidth}\begin{tabularx}{\linewidth}[t]{@{}X@{\hspace{1em}}r@{}}\strut#1 & {\color{softgray}#3}\end{tabularx}\\\textit{#2}\end{minipage}}
\fi

% ---------- Simple dated lines (awards, outreach) ----------
\newlist{dated}{itemize}{1}
\setlist[dated]{label={}, leftmargin=0pt, itemsep=0.35em, topsep=0.3em, parsep=0pt}
\ifleftdates
  \newcommand{\datedItem}[2]{\item{\color{softgray}\parbox[t]{\datecol}{\strut#2}}\parbox[t]{\dimexpr\linewidth-\datecol\relax}{\strut#1}}
\else
  \newcommand{\datedItem}[2]{\item\begin{tabularx}{\linewidth}{@{}X@{\hspace{1em}}r@{}}#1 & #2\end{tabularx}}
\fi

\newcommand{\me}{\textbf{J.~H.~Ko}}
\newcommand{\cofirst}{\textsuperscript{\dag}}
\newcommand{\cocorr}{\textsuperscript{*}}
